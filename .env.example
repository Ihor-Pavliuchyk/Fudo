# Use a PostgreSQL database. Never commit .env / .env.local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fudo?schema=public"
# Generate using: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Full public origin, used only when constructing password/email verification links
APP_URL="http://localhost:3000"
# Optional for real email. Without these, development mode prints email links to server logs.
RESEND_API_KEY=""
EMAIL_FROM="Fudo <no-reply@example.com>"
SUPPORT_EMAIL=""
